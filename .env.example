# ============================================================
# ЛОКАЛЬНАЯ РАЗРАБОТКА (копируй в .env.local)
# ============================================================

# Backend API (Vite proxy → http://localhost:4000)
VITE_API_URL=/api/v1

# ============================================================
# Keycloak OIDC (dev-инстанс из docker-compose.dev.yml)
# ============================================================
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/it-school
VITE_OIDC_CLIENT_ID=crm-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
VITE_OIDC_SCOPE=openid profile email roles

# ============================================================
# MinIO (через локальный nginx HTTPS)
# ============================================================
VITE_MINIO_PUBLIC_URL=https://localhost/storage

# ============================================================
# Web Push
# ============================================================
VITE_VAPID_PUBLIC_KEY=

# ============================================================
# Прочее
# ============================================================
VITE_SENTRY_DSN=
VITE_APP_VERSION=1.0.0

# ============================================================
# ПРОД-ЗНАЧЕНИЯ (не для локальной разработки!)
# Их устанавливает docker-compose.prod.yml через build args.
# Не дублируй здесь — иначе Vite подхватит последнее значение
# и локальная разработка пойдёт на прод-URL.
# ============================================================
# VITE_API_URL=https://crm.rt.ru/api/v1
# VITE_OIDC_AUTHORITY=https://keycloak.crm.rt.ru/realms/it-school
# VITE_OIDC_REDIRECT_URI=https://crm.rt.ru/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://crm.rt.ru

# ============================================================
# ClamAV — антивирус (ФСТЭК №117 п.19)
# ============================================================
# В локальной разработке можно выключить, если не поднимать
# отдельный контейнер clamav в docker-compose.dev.yml.
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000