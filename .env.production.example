# ============================================================
# Домены (должны указывать на IP сервера)
# ============================================================
APP_HOSTNAME=crm.rt.ru
KEYCLOAK_HOSTNAME=keycloak.crm.rt.ru
ACME_EMAIL=admin@rt.ru

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================
# Keycloak
# ============================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_BACKEND_SECRET=CHANGE_ME_KEYCLOAK_BACKEND_SECRET

# ============================================================
# MinIO (файловое хранилище)
# ============================================================
MINIO_ROOT_USER=crm_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ============================================================
# Web Push
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rt.ru

# ============================================================
# SMTP (для писем Keycloak)
# ============================================================
SMTP_HOST=smtp.rt.ru
SMTP_PORT=587
SMTP_USER=crm-noreply@rt.ru
SMTP_PASSWORD=CHANGE_ME_SMTP

# ============================================================
# OAuth state signing (Google Calendar)
# Оставь пустым — используется KEYCLOAK_BACKEND_SECRET.
# Для повышения изоляции задай отдельный 32+ символьный ключ.
# ============================================================
OAUTH_STATE_SECRET=

# ============================================================
# WhatsApp Business (Meta Cloud API)
# Секрет для HMAC-подписи webhook'ов. Обязателен в проде.
# ============================================================
WHATSAPP_APP_SECRET=

# ============================================================
# 152-ФЗ: шифрование персональных данных
#
# ОБЯЗАТЕЛЬНО в production. Ключ ≥32 символов.
# Генерация: openssl rand -base64 48
# ============================================================
PII_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_CRITICAL_CHAT_ID=-1001234567890
TELEGRAM_WARNINGS_CHAT_ID=-1001234567890

# ============================================================
# ClamAV — антивирус для загружаемых файлов (ФСТЭК №117 п.19)
# ============================================================
# По умолчанию включён. Для маленьких стендов и нагрузочных
# тестов можно выставить false — тогда проверка пропускается.
CLAMAV_ENABLED=true
# Хост и порт clamd. В docker-compose это имя сервиса.
# При запуске backend вне docker — localhost / IP сервера clamd.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Таймаут одной проверки в миллисекундах.
CLAMAV_TIMEOUT_MS=30000