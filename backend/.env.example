# ============================================================
# Server
# ============================================================
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
APP_URL=http://localhost:5173
APP_VERSION=1.0.0

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=postgresql://crm_user:crm_pass@localhost:5432/crm_db?schema=public

# ============================================================
# Redis (cache, rate limit, BullMQ)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Keycloak (OIDC)
# ============================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=it-school
KEYCLOAK_CLIENT_ID=crm-backend
KEYCLOAK_CLIENT_SECRET=backend-secret-change-in-prod

# ============================================================
# JWT (claims-проверка токенов, выданных Keycloak)
# ============================================================
JWT_ISSUER=http://localhost:8080/realms/it-school
JWT_AUDIENCE=account

# ============================================================
# Swagger
# ============================================================
SWAGGER_ENABLED=true

# ============================================================
# Rate limiting (global)
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ============================================================
# Cron
# ============================================================
ENABLE_CRON=true
HEARTBEAT_URL=
BACKUP_DIR=./backups

# ============================================================
# MinIO / S3
# ============================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=crm_minio
MINIO_SECRET_KEY=minio_pass_dev
MINIO_BUCKET=documents
MINIO_PUBLIC_URL=http://localhost/storage

# ============================================================
# Web Push (VAPID). Сгенерировать: npm run vapid
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rt.ru

# ============================================================
# Google Calendar OAuth (опционально)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/google/callback

# ============================================================
# WhatsApp webhook — HMAC-секрет Meta Cloud API (опционально).
# Если задан — подпись X-Hub-Signature-256 проверяется.
# ============================================================
WHATSAPP_APP_SECRET=

# ============================================================
# Observability
# ============================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
BODY_LOGGING=false

# ============================================================
# Tests
# ============================================================
# TEST_BYPASS_AUTH=true   # ТОЛЬКО для тестов, никогда в проде

# ============================================================
# PII-шифрование (152-ФЗ).
#
# В production ОБЯЗАТЕЛЬНО. Ключ ≥32 символов.
# Генерация: openssl rand -base64 48
#
# В dev-окружении допустимо оставить пустым — тогда контактные
# данные сохраняются в открытом виде (см. предупреждение в консоли).
# Значение ниже — тестовый dev-ключ, он БЕЗОПАСЕН только для dev.
# ============================================================
PII_KEY=dev-only-key-do-not-use-in-production-0123456789abcdef

# ============================================================
# OAuth state signing secret (для Google/др. OAuth-флоу).
# Если не задан — fallback на KEYCLOAK_CLIENT_SECRET.
# Минимум 32 символа.
# ============================================================
OAUTH_STATE_SECRET=

# ============================================================
# Сессии
# ============================================================
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_HOURS=10

# ============================================================
# Полный JSON-отчёт: лимиты по коллекциям
# ============================================================
# Меняйте, если на стенде много данных и нужен больший объём.
FULL_REPORT_LIMIT_UNIVERSITIES=1000
FULL_REPORT_LIMIT_INTERACTIONS=5000
FULL_REPORT_LIMIT_TASKS=5000
FULL_REPORT_LIMIT_CONTRACTS=2000
FULL_REPORT_LIMIT_COMMENTS=5000
FULL_REPORT_LIMIT_DOCUMENTS=2000
FULL_REPORT_LIMIT_NOTIFICATIONS=1000
FULL_REPORT_LIMIT_AUDIT=1000
FULL_REPORT_LIMIT_INBOX=500
FULL_REPORT_LIMIT_CALLS=500
FULL_REPORT_LIMIT_TRANSITIONS=5000
FULL_REPORT_LIMIT_SEGMENTS=500
FULL_REPORT_LIMIT_SAVED_VIEWS=200