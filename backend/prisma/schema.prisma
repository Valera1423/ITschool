generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, vector]
}

model Profile {
  id                  String             @id @db.Uuid
  email               String             @unique
  fullName            String             @map("full_name")
  role                String             @default("nam") @db.VarChar(20)
  avatarColor         String             @default("blue") @map("avatar_color")
  blocked             Boolean            @default(false)
  totpEnabled         Boolean            @default(false) @map("totp_enabled")
  keycloakSub         String?            @unique @map("keycloak_sub")
  lastLoginAt         DateTime?          @map("last_login_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  customRoleId        String?            @map("custom_role_id") @db.Uuid
  auditLogs           AuditLog[]
  contracts           Contract[]
  google_oauth_tokens GoogleOAuthToken?
  notifications       Notification[]
  customRole          CustomRole?        @relation(fields: [customRoleId], references: [id])
  pushSubscriptions   PushSubscription[]
  preferences         UserPreferences?
  scopes              UserScope[]
  sessions            UserSession[]

  @@map("profiles")
}

model ProfileSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  fullName             String   @map("full_name")
  email                String
  role                 String   @default("nam")
  workspaceName        String   @default("ИТ Школа РТК") @map("workspace_name")
  phone                String?
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  created_at           DateTime @default(now())
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("profile_settings")
}

model UserPreferences {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  onboardingDismissed Boolean  @default(false) @map("onboarding_dismissed")
  tourCompleted       Boolean  @default(false) @map("tour_completed")
  compactMode         Boolean  @default(false) @map("compact_mode")
  emailNotifications  Boolean  @default(true) @map("email_notifications")
  pushNotifications   Boolean  @default(true) @map("push_notifications")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserScope {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entity     String   @default("universities")
  filter     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updated_at DateTime
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity])
  @@index([entity])
  @@map("user_scopes")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  ip            String?
  userAgent     String?   @map("user_agent")
  deviceLabel   String?   @map("device_label")
  lastActiveAt  DateTime  @default(now()) @map("last_active_at")
  expiresAt     DateTime  @map("expires_at")
  revoked       Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  user          Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
  @@index([expiresAt])
  @@index([lastActiveAt])
  @@map("user_sessions")
}

model CustomRole {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(64)
  label       String    @db.VarChar(200)
  description String?
  permissions String[]  @default([])
  baseRole    String    @default("nam") @map("base_role") @db.VarChar(20)
  active      Boolean   @default(true)
  sortOrder   Int       @default(100) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  profiles    Profile[]

  @@index([active, sortOrder])
  @@map("custom_roles")
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  site        String?
  contactName    String?   @map("contact_name")
  contactPhone   String?   @map("contact_phone")
  contactEmail   String?   @map("contact_email")
  contactMethods String[]  @default([]) @map("contact_methods")
  notes          String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products     ItProduct[]
  universities University[]

  @@map("vendors")
}

model ItDirection {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  code         String?
  description  String?
  color        String       @default("sky")
  sortOrder    Int          @default(100) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  universities University[]

  @@map("it_directions")
}

model ItProduct {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  vendorId     String?      @map("vendor_id") @db.Uuid
  description  String?
  licenseType  String?      @map("license_type")
  color        String       @default("sky")
  sortOrder    Int          @default(100) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  universities University[]

  @@map("it_products")
}

model Manager {
  id           String       @id @default(uuid()) @db.Uuid
  profileId    String?      @map("profile_id") @db.Uuid
  fullName     String       @unique @map("full_name")
  email        String?
  phone        String?
  position     String?
  department   String?
  avatarColor  String       @default("blue") @map("avatar_color")
  active       Boolean      @default(true)
  sortOrder    Int          @default(100) @map("sort_order")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  universities University[]

  @@index([active, sortOrder])
  @@map("managers")
}

model University {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  city                String               @default("Москва")
  direction           String               @default("Разработка")
  product             String               @default("Ростелеком DataLab")
  vendorId            String?              @map("vendor_id") @db.Uuid
  directionId         String?              @map("direction_id") @db.Uuid
  productId           String?              @map("product_id") @db.Uuid
  managerId           String?              @map("manager_id") @db.Uuid
  contractNumber      String?              @map("contract_number")
  licenseSigned       Boolean              @default(false) @map("license_signed")
  licenseExpiresAt    DateTime?            @map("license_expires_at") @db.Date
  status              String               @default("Новый")
  handoverStatus      String               @default("Не передан") @map("handover_status")
  manager             String               @default("Анна Кузнецова")
  contactName         String?              @map("contact_name")
  contactEmail        String?              @map("contact_email")
  contactPhone        String?              @map("contact_phone")
  telegram            String?
  whatsapp            String?
  maxMessenger        String?              @map("max_messenger")
  source              String               @default("Вручную")
  notes               String?
  contractValue       Decimal              @default(0) @map("contract_value") @db.Decimal(14, 2)
  firstResponseAt     DateTime?            @map("first_response_at")
  expectedCloseDate   DateTime?            @map("expected_close_date") @db.Date
  closedAt            DateTime?            @map("closed_at")
  lossReason          String?              @map("loss_reason")
  deletedAt           DateTime?            @map("deleted_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  callLogs            CallLog[]
  comments            Comment[]
  contracts           Contract[]
  documents           Document[]
  inboxMessages       InboxMessage[]
  interactions        Interaction[]
  tasks               Task[]
  directionRef        ItDirection?         @relation(fields: [directionId], references: [id])
  managerRef          Manager?             @relation(fields: [managerId], references: [id])
  productRef          ItProduct?           @relation(fields: [productId], references: [id])
  vendor              Vendor?              @relation(fields: [vendorId], references: [id])
  contacts            UniversityContact[]
  tags                UniversityTag[]
  workflowTransitions WorkflowTransition[]
  workflowLinks       WorkflowUniversity[]

  @@index([deletedAt])
  @@index([status])
  @@index([manager])
  @@map("universities")
}

model UniversityContact {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @map("university_id") @db.Uuid
  fullName     String     @map("full_name")
  role         String?
  email        String?
  phone        String?
  telegram     String?
  whatsapp     String?
  isPrimary    Boolean    @default(false) @map("is_primary")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@map("university_contacts")
}

model Tag {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @unique
  color        String          @default("sky")
  description  String?
  createdAt    DateTime        @default(now()) @map("created_at")
  universities UniversityTag[]

  @@map("tags")
}

model UniversityTag {
  universityId String     @map("university_id") @db.Uuid
  tagId        String     @map("tag_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([universityId, tagId])
  @@index([tagId])
  @@map("university_tags")
}

model Interaction {
  id              String     @id @default(uuid()) @db.Uuid
  universityId    String     @map("university_id") @db.Uuid
  type            String     @default("Звонок")
  title           String
  details         String?
  interactionDate DateTime   @default(now()) @map("interaction_date") @db.Date
  status          String     @default("Запланировано")
  manager         String     @default("Анна Кузнецова")
  startTime       String?    @map("start_time")
  endTime         String?    @map("end_time")
  allDay          Boolean    @default(false) @map("all_day")
  meetingUrl      String?    @map("meeting_url")
  location        String?
  attendees       Json       @default("[]")
  reminderMinutes Int?       @map("reminder_minutes")
  color           String     @default("sky")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([interactionDate])
  @@index([universityId, interactionDate])
  @@map("interactions")
}

model Task {
  id           String      @id @default(uuid()) @db.Uuid
  universityId String?     @map("university_id") @db.Uuid
  title        String
  description  String?
  status       String      @default("К выполнению")
  priority     String      @default("Средний")
  dueDate      DateTime    @default(now()) @map("due_date") @db.Date
  reminderAt   DateTime?   @map("reminder_at")
  assignee     String      @default("Анна Кузнецова")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  university   University? @relation(fields: [universityId], references: [id])

  @@index([status])
  @@index([dueDate])
  @@index([assignee])
  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String?  @map("depends_on_task_id") @db.Uuid
  type            String   @default("finish_to_start")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@index([taskId])
  @@map("task_dependencies")
}

model Comment {
  id            String      @id @default(uuid()) @db.Uuid
  universityId  String?     @map("university_id") @db.Uuid
  author        String      @default("Анна Кузнецова")
  body          String
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  attachments   Json        @default("[]")
  interactionId String?     @map("interaction_id") @db.Uuid
  taskId        String?     @map("task_id") @db.Uuid
  updated_at    DateTime
  university    University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@map("comments")
}

model Mention {
  id          BigInt   @id @default(autoincrement())
  commentId   String   @map("comment_id") @db.Uuid
  mentionedId String   @map("mentioned_id") @db.Uuid
  mentionedAt DateTime @default(now()) @map("mentioned_at")
  read        Boolean  @default(false)

  @@unique([commentId, mentionedId])
  @@index([mentionedId, read])
  @@map("mentions")
}

model Workflow {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  status               String                   @default("Активен")
  runsCount            Int                      @default(0) @map("runs_count")
  deletedAt            DateTime?                @map("deleted_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  isDefault            Boolean                  @default(false) @map("is_default")
  steps                WorkflowStep[]
  transitionRules      WorkflowTransitionRule[]
  workflowUniversities WorkflowUniversity[]

  @@map("workflows")
}

model WorkflowStep {
  id                  String                   @id @default(uuid()) @db.Uuid
  workflowId          String                   @map("workflow_id") @db.Uuid
  title               String
  stepOrder           Int                      @default(1) @map("step_order")
  status              String                   @default("Ожидает")
  statusCode          String?                  @map("status_code")
  createdAt           DateTime                 @default(now()) @map("created_at")
  workflow            Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  transitionRulesFrom WorkflowTransitionRule[] @relation("RuleFromStep")
  transitionRulesTo   WorkflowTransitionRule[] @relation("RuleToStep")
  transitions         WorkflowTransition[]
  currentInUni        WorkflowUniversity[]

  @@index([workflowId, stepOrder])
  @@map("workflow_steps")
}

model WorkflowUniversity {
  id            String        @id @default(uuid()) @db.Uuid
  workflowId    String        @map("workflow_id") @db.Uuid
  universityId  String        @map("university_id") @db.Uuid
  currentStepId String?       @map("current_step_id") @db.Uuid
  status        String        @default("В работе")
  startedAt     DateTime      @default(now()) @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  currentStep   WorkflowStep? @relation(fields: [currentStepId], references: [id])
  university    University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  workflow      Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, universityId])
  @@index([universityId])
  @@map("workflow_universities")
}

model WorkflowTransition {
  id           String       @id @default(uuid()) @db.Uuid
  stepId       String       @map("step_id") @db.Uuid
  universityId String       @map("university_id") @db.Uuid
  fromStatus   String?      @map("from_status")
  toStatus     String       @map("to_status")
  comment      String
  attachments  Json         @default("[]")
  actorName    String       @map("actor_name")
  actorId      String?      @map("actor_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  step         WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([stepId, createdAt])
  @@index([universityId, createdAt])
  @@map("workflow_transitions")
}

model WorkflowTransitionRule {
  id              String       @id @default(uuid()) @db.Uuid
  workflowId      String       @map("workflow_id") @db.Uuid
  fromStepId      String       @map("from_step_id") @db.Uuid
  toStepId        String       @map("to_step_id") @db.Uuid
  condition       Json         @default("{}")
  requiresComment Boolean      @default(true) @map("requires_comment")
  createdAt       DateTime     @default(now()) @map("created_at")
  fromStep        WorkflowStep @relation("RuleFromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep          WorkflowStep @relation("RuleToStep", fields: [toStepId], references: [id], onDelete: Cascade)
  workflow        Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, fromStepId, toStepId])
  @@index([fromStepId])
  @@index([toStepId])
  @@index([workflowId])
  @@map("workflow_transition_rules")
}

model WorkflowStatusCatalog {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  color     String   @default("slate")
  sortOrder Int      @default(100) @map("sort_order")
  isFinal   Boolean  @default(false) @map("is_final")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("workflow_status_catalog")
}

model Contract {
  id               String             @id @default(uuid()) @db.Uuid
  universityId     String             @map("university_id") @db.Uuid
  title            String
  contractNumber   String?            @map("contract_number")
  amount           Decimal            @default(0) @db.Decimal(14, 2)
  currency         String             @default("RUB")
  status           String             @default("Черновик")
  currentStep      Int                @default(0) @map("current_step")
  signedAt         DateTime?          @map("signed_at")
  expiresAt        DateTime?          @map("expires_at") @db.Date
  signedDocumentId String?            @map("signed_document_id") @db.Uuid
  notes            String?
  createdBy        String?            @map("created_by") @db.Uuid
  deletedAt        DateTime?          @map("deleted_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  approvals        ContractApproval[]
  versions         ContractVersion[]
  profiles         Profile?           @relation(fields: [createdBy], references: [id])
  university       University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  edoDocuments     EdoDocument[]

  @@index([universityId])
  @@index([status])
  @@map("contracts")
}

model ContractApproval {
  id           String    @id @default(uuid()) @db.Uuid
  contractId   String    @map("contract_id") @db.Uuid
  stepOrder    Int       @map("step_order")
  role         String
  approverName String?   @map("approver_name")
  approverId   String?   @map("approver_id") @db.Uuid
  status       String    @default("Ожидает")
  comment      String?
  decidedAt    DateTime? @map("decided_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, stepOrder])
  @@map("contract_approvals")
}

model ContractVersion {
  id          String   @id @default(uuid()) @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  version     Int      @default(1)
  documentId  String?  @map("document_id") @db.Uuid
  storagePath String   @map("storage_path")
  name        String
  sizeBytes   BigInt   @default(0) @map("size_bytes")
  uploadedBy  String   @map("uploaded_by")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, version])
  @@map("contract_versions")
}

model EdoDocument {
  id               String    @id @default(uuid()) @db.Uuid
  contractId       String    @map("contract_id") @db.Uuid
  provider         String
  externalId       String?   @map("external_id")
  status           String    @default("draft")
  document_type    String    @default("contract")
  boxId            String?   @map("box_id")
  signedAt         DateTime? @map("signed_at")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionComment String?   @map("rejection_comment")
  rawData          Json      @default("{}") @map("raw_data")
  createdAt        DateTime  @default(now()) @map("created_at")
  updated_at       DateTime
  contract         Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([provider, externalId])
  @@map("edo_documents")
}

model Document {
  id               String     @id @default(uuid()) @db.Uuid
  universityId     String     @map("university_id") @db.Uuid
  name             String
  description      String?
  category         String     @default("Документ")
  storagePath      String     @map("storage_path")
  mimeType         String     @map("mime_type")
  sizeBytes        BigInt     @default(0) @map("size_bytes")
  version          Int        @default(1)
  parentDocumentId String?    @map("parent_document_id") @db.Uuid
  uploadedBy       String     @default("Пользователь") @map("uploaded_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  deletedAt        DateTime?  @map("deleted_at")
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@map("documents")
}

model Segment {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  entity      String    @default("universities")
  rules       Json      @default("[]")
  logic       String    @default("AND")
  color       String    @default("sky")
  createdBy   String?   @map("created_by") @db.Uuid
  shared      Boolean   @default(false)
  autoRefresh Boolean   @default(true) @map("auto_refresh")
  lastCount   Int       @default(0) @map("last_count")
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("segments")
}

model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  entity    String   @default("universities")
  filters   Json     @default("{}")
  sort      Json?
  color     String?
  icon      String?
  pinned    Boolean  @default(false)
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, entity])
  @@map("saved_views")
}

model Dashboard {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  shared      Boolean  @default(false)
  layout      Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("dashboards")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  entity    String?
  entityId  String?  @map("entity_id") @db.Uuid
  actionUrl String?  @map("action_url")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model PushSubscription {
