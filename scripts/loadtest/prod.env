# ============================================================
# Конфиг для запуска k6 на прод-стенде.
#
# Использование:
#   source scripts/loadtest/prod.env
#   k6 run scripts/loadtest/mixed-load.js
#
# ВАЖНО: перед запуском убедись, что rate-limit поднят
# в .env на сервере (см. pre-run чек-лист в README).
# ============================================================

# ── Куда стучимся
export BASE_URL="https://crm.rt.ru/api/v1"

# ── JWT access_token реального пользователя.
#    Получить: DevTools → Application → Local Storage →
#    oidc.user:https://keycloak.crm.rt.ru/realms/it-school:crm-frontend
#    → поле access_token.
#
#    Срок жизни токена в Keycloak = 900 сек (15 мин).
#    Для теста длиннее 15 минут — либо обнови accessTokenLifespan
#    в realm до 3600 на время прогона, либо получи токен через
#    direct grant (curl .../token grant_type=password).
export TOKEN="__PASTE_TOKEN_HERE__"

# ── ID вуза для фильтрации тяжёлых отчётов (по желанию).
#    Если пусто — берутся все вузы (максимально тяжёлый вариант).
export TEST_UNIVERSITY_ID=""

# ── Включить PDF/XLSX в прогон отчётов (10-reports.js).
#    false → только JSON, true → + файлы
export EXPORT_ENABLED="true"

# ── Отключить bypass auth (по умолчанию — не используем).
#    Для прод-стенда TEST_BYPASS_AUTH не должен быть включён.
unset TEST_BYPASS_AUTH
unset TEST_USER_ID